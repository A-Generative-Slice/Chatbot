# Server
PORT=3000

# WhatsApp API
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_permanent_access_token
WHATSAPP_VERIFY_TOKEN=your_verify_token

# Sarvam AI
SARVAM_API_KEY=your_sarvam_api_key

# Database
MONGODB_URI=your_mongodb_connection_string

# Website API
WEBSITE_API_URL=https://rosechemicals.in
WEBSITE_URL=https://rosechemicals.in

# Railway Deployment URLs
WHATSAPP_WEBHOOK_CALLBACK_URL=https://your-app.up.railway.app/webhook
WEBHOOK_URL=https://your-app.up.railway.app/ping

# Admin API
ADMIN_API_KEY=your_admin_api_key

# Template Batch Sender (optional)
TEST_BATCH_FILE=./test_numbers.txt
TEST_TEMPLATE_NAME=rc
TEST_TEMPLATE_LANG=en
TEST_BATCH_LIMIT=10
TEST_BATCH_DELAY_MS=1200
TEST_TEMPLATE_HEADER_IMAGE_URL=

# Send to previous chat recipients (optional)
TEST_RECENT_DAYS=0
